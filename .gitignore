# 依赖
node_modules/

# 构建产物
backend/dist/
frontend/dist/
backend/exe-assets/

# 本地打包验证的临时目录（exe 产物与下载的 CI artifact）
_test-build/
tmp-release/

# 浏览器自动化残留（各验证脚本的 user-data-dir：.tmp-chrome-progress / -anchor / -practice-ui / -shot …）
.tmp-chrome-*/

# 环境配置与密钥（含数据库密码，绝不上传）
.env
.env.*
!.env.example
!.env.*.example

# 用户上传的文件（业务数据，不属于代码）
backend/uploads/

# 代理上网静态资源磁盘缓存（可随时手工删除）
backend/cache/

# 数据导入导出运行时目录（备份快照与导入临时文件，含业务数据）
backend/backups/
backend/tmp-data-io/

# 数据库备份（含账号散列与 API 密钥，仅忽略根目录下的导出文件；
# backend/database/migrations/ 下的迁移脚本是代码，必须入库）
/*.sql

# 日志
*.log

# Python 缓存
__pycache__/
*.pyc

# 编辑器/IDE 配置
.trae/
.vscode/
.idea/
.aionrs/
.superpowers/

# 工作区本地数据（会话记录、记忆、临时工具，不属于代码）
.workbuddy/
