# 通用示例。实际运行请优先使用 .env.development 或 .env.production。
NODE_ENV=development

# 服务器配置
PORT=3001
HOST=0.0.0.0

# MariaDB 数据库配置
DB_HOST=192.168.10.110
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=xgpy
TOKEN_SECRET=请设置一个足够长的随机字符串

# ===== 数据导入导出（.xgpybak）=====
# 导入前自动快照是否包含 uploads 文件资源。
# 默认 1（含文件，可整库还原）；uploads 很大、磁盘紧张时设为 0，
# 快照只备份数据表（本机实测 61MB -> 2.3MB）。
# 注意：0 模式下快照无法还原已上传的图片/视频。
DB_SNAPSHOT_INCLUDE_FILES=1
# 快照保留份数，默认 5。按修改时间保留最新的 N 份。
DB_SNAPSHOT_KEEP=5
# 导入时等待表锁的上限（秒），默认 30。撞锁会快速失败并提示重试。
DB_IMPORT_LOCK_WAIT_TIMEOUT=30
